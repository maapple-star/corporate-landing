---
import { contactEmail, contactPhone, address } from "../../constants/info";
import Link from "./link.astro";
import LogoFull from "../../assets/logo-full-white.png";

const links = [
  {
    id: "navigation",
    title: "Navigation",
    links: [
      {
        id: "home",
        label: "Home",
        href: "#home",
      },
      {
        id: "why",
        label: "Why Maple Star?",
        href: "#why",
      },
      {
        id: "solutions",
        label: "Solutions",
        href: "#solutions",
      },
      {
        id: "partners",
        label: "Partners",
        href: "#partners",
      },
      {
        id: "contact",
        label: "Contact",
        href: "#contact",
      },
    ],
  },
  {
    id: "solutions",
    title: "Solutions",
    links: [
      {
        id: "hardware-infrastructure",
        label: "Hardware Infrastructure",
        href: "#services",
      },
      {
        id: "wireless-solutions",
        label: "Wireless Solutions",
        href: "#services",
      },
      {
        id: "surveillance",
        label: "Surveillance",
        href: "#services",
      },
      {
        id: "disaster-recovery",
        label: "Disaster Recovery",
        href: "#services",
      },
      {
        id: "ip-telephony",
        label: "IP Telephony",
        href: "#services",
      },
    ],
  },
];

const socialLinks = [
  {
    id: "facebook",
    label: "Facebook",
    href: "https://www.facebook.com/maplestarcomputers",
  },
  {
    id: "linkedin",
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/maplestarcomputers",
  },
  {
    id: "instagram",
    label: "Instagram",
    href: "https://www.instagram.com/maplestarcomputers",
  },
];
---

<footer class="bg-dark text-white pt-20 px-[6%] pb-10" id="footer">
  <div class="grid grid-cols-1 gap-[60px] mb-[60px] md:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-6">
      <img {...LogoFull} alt="Maple Star Computers LLC" />
      <p class="text-[0.85rem] text-white/80 leading-[1.8]">
        Enterprise ICT integration solutions across the UAE. Your trusted digital transformation
        partner.
      </p>
    </div>

    {
      links.map((link) => (
        <div>
          <div class="text-[0.65rem] tracking-[0.2em] uppercase text-blue3 mb-6">{link.title}</div>
          <ul class="list-none flex flex-col gap-3">
            {link.links.map((link) => (
              <li>
                <Link href={link.href}>{link.label}</Link>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <div class="text-[0.65rem] tracking-[0.2em] uppercase text-blue3 mb-6">Contact</div>
      <p class="text-[0.85rem] text-white/80 leading-[1.8]">
        <span> {address.line1} </span>
        <br />
        <span class="mb-2 block"> {address.line2} </span>
        <br />
        <Link href={`mailto:${contactEmail}`}>
          {contactEmail}
        </Link>
        <br />
        <Link href={`tel:${contactPhone.value}`} class="mb-2 block">{contactPhone.label}</Link>
        <br />
        {
          socialLinks.map((link) => (
            <Link href={link.href} class="mb-2 block">
              {link.label}
            </Link>
          ))
        }
      </p>
    </div>
  </div>
  <div class="border-t border-white/10 py-10 mb-6">
    <div class="text-[0.65rem] tracking-[0.2em] uppercase text-blue3 mb-6">Other Services</div>
    <div class="flex flex-wrap gap-4">
      <a
        href="https://refurbished.maplestar.ae"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 border border-white/15 rounded-lg px-5 py-4 hover:border-blue3/60 hover:bg-white/5 transition-all group"
      >
        <div>
          <div
            class="text-[0.75rem] font-semibold text-white group-hover:text-blue3 transition-colors"
          >
            Refurbished Laptops
          </div>
          <div class="text-[0.7rem] text-white/50 mt-0.5">refurbished.maplestar.ae</div>
        </div>
        <svg
          class="w-3.5 h-3.5 text-white/30 group-hover:text-blue3 transition-colors ml-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
      <a
        href="https://repairyourlaptop.ae"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 border border-white/15 rounded-lg px-5 py-4 hover:border-blue3/60 hover:bg-white/5 transition-all group"
      >
        <div>
          <div
            class="text-[0.75rem] font-semibold text-white group-hover:text-blue3 transition-colors"
          >
            Repair Your Laptop
          </div>
          <div class="text-[0.7rem] text-white/50 mt-0.5">repairyourlaptop.ae</div>
        </div>
        <svg
          class="w-3.5 h-3.5 text-white/30 group-hover:text-blue3 transition-colors ml-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="border-t border-text pt-7 flex justify-between text-[0.75rem] text-white/80">
    <span>&copy; {new Date().getFullYear()} Maple Star Computers LLC. All rights reserved.</span>
    <span class="text-blue2">ICT Integration &middot; UAE</span>
  </div>
</footer>
